<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Restore from nuget.org only, so builds do not depend on whatever sources a developer
         happens to have configured machine-wide. -->
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
    </packageSources>
</configuration>
